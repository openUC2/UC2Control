<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ============ Brand header ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:adjustViewBounds="true"
            android:src="@drawable/uc2_logo"
            android:contentDescription="@string/cd_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/status_dot"
                android:contentDescription="@string/cd_status" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textColor="@color/text_on_brand"
                android:textSize="12sp"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Connection bar ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout style="@style/Row">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <TextView style="@style/Text.Label" android:text="@string/baud" />

                <Spinner
                    android:id="@+id/spinner_baud"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_baud"
                style="@style/Btn.Outline"
                android:layout_gravity="bottom"
                android:text="@string/apply_baud" />
        </LinearLayout>

        <LinearLayout
            style="@style/Row"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/connect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_diagnostics"
                style="@style/Btn.Outline"
                android:text="@string/diagnostics" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Tabs ============ -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/go"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/text_muted"
        app:tabRippleColor="@color/uc2_blue_tint"
        app:tabTextAppearance="@style/Text.Tab" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ============ Tab content ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/tab_scan" />
        <include layout="@layout/tab_stage" />
        <include layout="@layout/tab_light" />
        <include layout="@layout/tab_setup" />
        <include layout="@layout/tab_console" />
    </FrameLayout>
</LinearLayout>
