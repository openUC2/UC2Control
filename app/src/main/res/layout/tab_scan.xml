<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_content_scan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ===== Live view ===== -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.SectionTitle" android:text="@string/live_title" />
            <TextView
                android:id="@+id/tv_cam_status"
                style="@style/Text.Hint"
                android:text="@string/cam_hint" />

            <!-- Letterboxed to the camera's aspect ratio inside a fixed box;
                 a TextureView cannot have a background of its own. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_console">

                <com.serenegiant.widget.AspectRatioTextureView
                    android:id="@+id/tex_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout style="@style/Row" android:layout_marginBottom="10dp">
                <Spinner
                    android:id="@+id/sp_camera"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:contentDescription="@string/camera_type" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_camera"
                    style="@style/Btn.Outline"
                    android:text="@string/camera_connect" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:text="@string/exposure" />
                    <EditText android:id="@+id/et_exposure" style="@style/NumberInput"
                        android:inputType="numberDecimal" android:text="10" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:text="@string/gain" />
                    <EditText android:id="@+id/et_gain" style="@style/NumberInput"
                        android:inputType="numberDecimal" android:text="0" android:autofillHints="" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_exposure"
                    style="@style/Btn"
                    android:layout_gravity="bottom"
                    android:text="@string/apply_exposure" />
            </LinearLayout>
            <TextView
                style="@style/Text.Hint"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="0dp"
                android:text="@string/exposure_hint" />
        </LinearLayout>

        <!-- ===== Stage overview + jog ===== -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.SectionTitle" android:text="@string/overview_title" />
            <TextView style="@style/Text.Hint" android:text="@string/overview_hint" />

            <com.openuc2.control.StageMapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:contentDescription="@string/cd_map" />

            <TextView
                android:id="@+id/tv_position"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:text="@string/position_unknown" />

            <LinearLayout style="@style/Row" android:layout_marginBottom="10dp">
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:textAllCaps="false" android:text="@string/jog_step" />
                <EditText
                    android:id="@+id/et_jog_step"
                    style="@style/NumberInput"
                    android:layout_width="120dp"
                    android:inputType="numberDecimal"
                    android:text="100"
                    android:autofillHints="" />
            </LinearLayout>

            <!-- Jog cross. Y− is on top because the map draws +Y downwards (image rows). -->
            <LinearLayout style="@style/Row" android:layout_marginBottom="6dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_y_minus" style="@style/Btn.Jog" android:text="Y−" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_z_plus" style="@style/Btn.Jog.Continuous" android:text="Z+" />
            </LinearLayout>
            <LinearLayout style="@style/Row" android:layout_marginBottom="6dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_x_minus" style="@style/Btn.Jog" android:text="X−" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_stop" style="@style/Btn.Jog.Stop" android:text="Stop" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_x_plus" style="@style/Btn.Jog" android:text="X+" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout style="@style/Row">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_y_plus" style="@style/Btn.Jog" android:text="Y+" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_z_minus" style="@style/Btn.Jog.Continuous" android:text="Z−" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Tile scan ===== -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.SectionTitle" android:text="@string/scan_title" />
            <TextView style="@style/Text.Hint" android:text="@string/scan_hint" />

            <LinearLayout style="@style/Row" android:layout_marginBottom="10dp">
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:textAllCaps="false" android:text="@string/pixel_size" />
                    <EditText android:id="@+id/et_px_size" style="@style/NumberInput"
                        android:inputType="numberDecimal" android:text="1.0" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:text="@string/image_width" />
                    <EditText android:id="@+id/et_img_w" style="@style/NumberInput"
                        android:inputType="number" android:text="1920" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn" android:layout_marginEnd="0dp">
                    <TextView style="@style/Text.Label" android:text="@string/image_height" />
                    <EditText android:id="@+id/et_img_h" style="@style/NumberInput"
                        android:inputType="number" android:text="1080" android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Row" android:layout_marginBottom="10dp">
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:text="@string/tiles_x" />
                    <EditText android:id="@+id/et_nx" style="@style/NumberInput"
                        android:inputType="number" android:text="3" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:text="@string/tiles_y" />
                    <EditText android:id="@+id/et_ny" style="@style/NumberInput"
                        android:inputType="number" android:text="3" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn" android:layout_marginEnd="0dp">
                    <TextView style="@style/Text.Label" android:text="@string/overlap" />
                    <EditText android:id="@+id/et_overlap" style="@style/NumberInput"
                        android:inputType="numberDecimal" android:text="25" android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Row" android:layout_marginBottom="6dp">
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:textAllCaps="false" android:text="@string/step_x" />
                    <EditText android:id="@+id/et_step_x" style="@style/NumberInput"
                        android:inputType="numberDecimal" android:hint="@string/auto" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:textAllCaps="false" android:text="@string/step_y" />
                    <EditText android:id="@+id/et_step_y" style="@style/NumberInput"
                        android:inputType="numberDecimal" android:hint="@string/auto" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn" android:layout_marginEnd="0dp">
                    <TextView style="@style/Text.Label" android:text="@string/settle" />
                    <EditText android:id="@+id/et_settle" style="@style/NumberInput"
                        android:inputType="number" android:text="200" android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox android:id="@+id/cb_snake" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/snake" />
            <CheckBox android:id="@+id/cb_centred" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true" android:text="@string/centred" />
            <CheckBox android:id="@+id/cb_return" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true" android:text="@string/return_to_start" />
            <CheckBox android:id="@+id/cb_gallery" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true" android:text="@string/copy_to_gallery" />

            <TextView
                android:id="@+id/tv_scan_info"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout style="@style/Row">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_start"
                    style="@style/Btn.Go"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/scan_start" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_end"
                    style="@style/Btn.Danger"
                    android:text="@string/scan_stop" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_scan"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progressTint="@color/go" />

            <TextView
                android:id="@+id/tv_scan_status"
                style="@style/Text.Hint"
                android:layout_marginTop="4dp"
                android:text="@string/scan_ready" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Btn.Outline"
                android:layout_width="match_parent"
                android:text="@string/share_scan" />
        </LinearLayout>

        <!-- ===== Stage hardware ===== -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.SectionTitle" android:text="@string/stage_hw_title" />
            <TextView style="@style/Text.Hint" android:text="@string/stage_hw_hint" />

            <TextView style="@style/Text.Label" android:text="@string/protocol" />
            <Spinner
                android:id="@+id/sp_stage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <LinearLayout style="@style/Row" android:layout_marginBottom="10dp">
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:textAllCaps="false" android:text="@string/ums_x" />
                    <EditText android:id="@+id/et_ums_x" style="@style/NumberInput"
                        android:inputType="numberDecimal|numberSigned" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:textAllCaps="false" android:text="@string/ums_y" />
                    <EditText android:id="@+id/et_ums_y" style="@style/NumberInput"
                        android:inputType="numberDecimal|numberSigned" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/col_ums_z" style="@style/FieldColumn" android:layout_marginEnd="0dp">
                    <TextView style="@style/Text.Label" android:textAllCaps="false" android:text="@string/ums_z" />
                    <EditText android:id="@+id/et_ums_z" style="@style/NumberInput"
                        android:inputType="numberDecimal|numberSigned" android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Row" android:layout_marginBottom="6dp">
                <LinearLayout style="@style/FieldColumn">
                    <TextView style="@style/Text.Label" android:text="@string/stage_speed" />
                    <EditText android:id="@+id/et_stage_speed" style="@style/NumberInput"
                        android:inputType="number" android:autofillHints="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/col_overshoot" style="@style/FieldColumn" android:layout_marginEnd="0dp">
                    <TextView style="@style/Text.Label" android:textAllCaps="false" android:text="@string/overshoot" />
                    <EditText android:id="@+id/et_overshoot" style="@style/NumberInput"
                        android:inputType="number" android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox android:id="@+id/cb_flip_x" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/flip_x" />
            <CheckBox android:id="@+id/cb_flip_y" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/flip_y" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
