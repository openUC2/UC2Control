<?xml version="1.0" encoding="utf-8"?>
<!--
  Devices that cause Android to offer this app when a board is plugged in.
  vendor-id / product-id are DECIMAL here, which is a classic source of typos —
  the hex value is in the comment on every line.

  Keep this list in step with UsbDrivers.prober().
-->
<resources>

    <!-- ============ Espressif native USB (ESP32-S2 / S3 / C3) ============ -->
    <usb-device vendor-id="12346" product-id="4097" />  <!-- 303A:1001 S3 / Arduino core -->
    <usb-device vendor-id="12346" product-id="4096" />  <!-- 303A:1000 -->
    <usb-device vendor-id="12346" product-id="2" />     <!-- 303A:0002 S2 CDC -->
    <usb-device vendor-id="12346" product-id="9" />     <!-- 303A:0009 -->
    <usb-device vendor-id="12346" product-id="16385" /> <!-- 303A:4001 -->
    <usb-device vendor-id="12346" product-id="16386" /> <!-- 303A:4002 -->
    <usb-device vendor-id="12346" />                    <!-- 303A any Espressif -->

    <!-- ============ Silicon Labs CP210x ============ -->
    <usb-device vendor-id="4292" product-id="60000" />  <!-- 10C4:EA60 CP2102/2109 -->
    <usb-device vendor-id="4292" product-id="60016" />  <!-- 10C4:EA70 CP2105 -->
    <usb-device vendor-id="4292" product-id="60017" />  <!-- 10C4:EA71 CP2108 -->
    <usb-device vendor-id="4292" />                     <!-- 10C4 any SiLabs -->

    <!-- ============ WCH CH340 / CH341 / CH343 / CH9102 ============ -->
    <usb-device vendor-id="6790" product-id="29987" />  <!-- 1A86:7523 CH340 -->
    <usb-device vendor-id="6790" product-id="21795" />  <!-- 1A86:5523 CH341A -->
    <usb-device vendor-id="6790" product-id="21971" />  <!-- 1A86:55D3 CH343 -->
    <usb-device vendor-id="6790" product-id="21972" />  <!-- 1A86:55D4 CH9102F -->
    <usb-device vendor-id="6790" product-id="21973" />  <!-- 1A86:55D5 CH9101 -->
    <usb-device vendor-id="6790" />                     <!-- 1A86 any WCH -->

    <!-- ============ FTDI ============ -->
    <usb-device vendor-id="1027" />                     <!-- 0403 -->

    <!-- ============ Prolific ============ -->
    <usb-device vendor-id="1659" />                     <!-- 067B -->

    <!-- ============ Generic CDC-ACM ============ -->
    <usb-device class="2" subclass="2" />                <!-- comm / ACM -->
    <usb-device class="2" />
    <usb-device class="10" />                            <!-- CDC data -->
</resources>
